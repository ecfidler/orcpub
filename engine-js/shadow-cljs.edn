;; Build for @pubdoor/dmv. See orc-alchemy docs/plan/HANDOFF-phase-a.md §5.1.
;;
;; The engine compiles in place from ../src/cljc and ../src/cljs. Only the
;; namespaces the facade requires are compiled, so the old UI (orcpub.core,
;; views, events) and the excluded namespaces (pdf_spec, character/random,
;; char_decision_tree, templates/*) stay out as long as nothing requires them.
;; engine-js/test/bundle.test.ts checks that they stay out.
;;
;; Two builds, both run by `npm run build`:
;;   pubdoor  the engine, dist/pubdoor.js. orcpub.dnd.e5.monsters is aliased
;;            to an empty stand-in (orcpub.facade.no-monsters), because only
;;            the old app's monster subscriptions in spell_subs.cljs use it.
;;   content  a Node script that writes the SRD content lists, monsters
;;            included, to dist/content/*.json (orcpub.facade.content).
{:source-paths ["src" "../src/cljc" "../src/cljs"]

 ;; Versions match project.clj.
 :dependencies [[re-frame "1.4.4"]
                [reagent "2.0.1"]
                [cljs-http "0.1.49"]
                [bidi "2.1.6"]
                [com.cognitect/transit-cljs "0.8.280"]]

 :builds
 {:pubdoor
  {:target :esm
   :output-dir "dist"
   :modules {:pubdoor {:exports {evaluate orcpub.facade/evaluate
                                         importCharacter orcpub.facade/importCharacter
                                         readServerEdn orcpub.facade/readServerEdn
                                         exportCharacter orcpub.facade/exportCharacter
                                         emptyCharacter orcpub.facade/emptyCharacter
                                         select orcpub.facade/select
                                         deselect orcpub.facade/deselect
                                         setValue orcpub.facade/setValue
                                         setField orcpub.facade/setField
                                         addLevel orcpub.facade/addLevel
                                         removeLevel orcpub.facade/removeLevel
                                         setClass orcpub.facade/setClass
                                         addClass orcpub.facade/addClass
                                         removeClass orcpub.facade/removeClass
                                         addStartingEquipment orcpub.facade/addStartingEquipment
                                         addInventoryItem orcpub.facade/addInventoryItem
                                         removeInventoryItem orcpub.facade/removeInventoryItem
                                         increaseAbility orcpub.facade/increaseAbility
                                         decreaseAbility orcpub.facade/decreaseAbility
                                         autofill orcpub.facade/autofill
                                         parseOrcbrew orcpub.facade/parseOrcbrew
                                         buildTemplate orcpub.facade/buildTemplate
                                         validateForExport orcpub.facade/validateForExport
                                         orcbrewToEdn orcpub.facade/orcbrewToEdn
                                         reconcileMissingContent orcpub.facade/reconcileMissingContent
                                         renameKey orcpub.facade/renameKey
                                         keys orcpub.facade/keys
                                         validate orcpub.facade/validate}}}
   :build-options {:ns-aliases {orcpub.dnd.e5.monsters orcpub.facade.no-monsters}}
   :compiler-options {:optimizations :advanced}}

  :content
  {:target :node-script
   :main orcpub.facade.content/main
   :output-to "target/content.cjs"
   :compiler-options {:optimizations :simple}}}}
